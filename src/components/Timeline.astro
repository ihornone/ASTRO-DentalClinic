---
import Animate from './Animate.astro';

const steps = [
  { num: '01', title: 'Консультація' },
  { num: '02', title: 'Діагностика' },
  { num: '03', title: 'План лікування' },
  { num: '04', title: 'Процедура' },
  { num: '05', title: 'Відновлення' },
  { num: '06', title: 'Готово!' },
];
---

<section class="section-gap bg-white overflow-hidden">
  <div class="section-container">
    <Animate>
      <h2 class="heading-lg text-center mb-16">Як проходить лікування</h2>
    </Animate>
    <div class="flex items-start gap-2 md:gap-4 overflow-x-auto pb-4 px-6 md:justify-center" style="scrollbar-width: none" data-stagger>
      {steps.map((item, i) => (
        <div class="flex items-center flex-shrink-0">
          <Animate stagger>
            <div class="flex flex-col items-center w-[90px] md:w-[110px]">
              <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-white shadow-lg flex items-center justify-center text-primary mb-3">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </div>
              <span class="text-primary font-bold text-sm md:text-base mb-1">{item.num}</span>
              <span class="text-on-surface font-semibold text-xs md:text-sm text-center leading-tight">{item.title}</span>
            </div>
          </Animate>
          {i < 5 && (
            <svg class="w-5 h-5 md:w-6 md:h-6 text-primary flex-shrink-0 mx-1 md:mx-2 mt-[-30px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
