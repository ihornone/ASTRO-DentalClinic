---
import Animate from './Animate.astro';
---

<section class="bg-white py-12 md:py-16">
  <div class="section-container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6" data-stagger>
      {[
        { num: 'Огляд', label: 'Розберемося, що вас турбує' },
        { num: 'План', label: 'Пояснимо варіанти лікування' },
        { num: 'Кошторис', label: 'Погодимо вартість до початку' },
        { num: 'Турбота', label: 'Підкажемо, як зберегти результат' },
      ].map((stat) => (
        <Animate stagger>
          <div class="glass-card p-5 md:p-6 text-center">
            <p class="text-xl md:text-2xl font-bold text-primary">{stat.num}</p>
            <p class="text-body-md text-on-surface-variant mt-1">{stat.label}</p>
          </div>
        </Animate>
      ))}
    </div>
  </div>
</section>
