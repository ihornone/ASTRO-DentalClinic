---
import Animate from './Animate.astro';
---

<section id="contact" class="relative">
  <div class="relative z-10 -mt-20">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full block" preserveAspectRatio="none">
      <path d="M0,80 L1440,80 L1440,40 C1260,60 1080,20 720,40 C360,60 180,30 0,40 Z" fill="#d1e4ee"/>
      <path d="M0,40 C180,30 360,60 720,40 C1080,20 1260,60 1440,40 L1440,0 L0,0 Z" fill="white"/>
    </svg>
  </div>
  <div class="bg-[#d1e4ee]">
    <div class="section-container pt-10 pb-8 md:pt-10 md:pb-8">
      <div class="grid md:grid-cols-2 gap-16">
        <Animate direction="left">
          <div>
            <h2 class="heading-lg mb-6">Зв'яжіться з нами</h2>
            <p class="body-lg mb-8">Готові змінити свою посмішку? Зв'яжіться з нами сьогодні, щоб записатись на прийом.</p>
            <div class="space-y-6">
              {[
                { label: 'Адреса', value: 'вул. Стоматологічна, 123, Медичне місто', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z' },
                { label: 'Телефон', value: '+38 (050) 123-45-67', icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' },
                { label: 'Години роботи', value: 'Пн-Пт: 8:00-18:00, Сб: 9:00-15:00', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
              ].map((item) => (
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-on-surface">{item.label}</p>
                    <p class="body-md">{item.value}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </Animate>
        <div class="bg-white p-8 rounded-3xl shadow-lg">
          <form class="space-y-5" onSubmit="return false">
            <div>
              <label class="block text-sm font-semibold text-on-surface mb-2">Ім'я та прізвище</label>
              <input type="text" class="w-full px-5 py-4 rounded-2xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-surface" placeholder="Іван Петренко" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-on-surface mb-2">Телефон</label>
              <input type="tel" class="w-full px-5 py-4 rounded-2xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-surface" placeholder="+38 (050) 000-00-00" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-on-surface mb-2">Послуга</label>
              <select class="w-full px-5 py-4 rounded-2xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-surface">
                <option>Оберіть послугу</option>
                <option>Відбілювання зубів</option>
                <option>Зубні імпланти</option>
                <option>Ортодонтія</option>
                <option>Лікування каналів</option>
                <option>Зубні коронки</option>
                <option>Невідкладна допомога</option>
              </select>
            </div>
            <button type="submit" class="btn-primary w-full">Записатись</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
